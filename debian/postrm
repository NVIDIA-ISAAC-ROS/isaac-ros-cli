set -e

rm_conffile() {
    local base_path="$1"

    rm -f "$base_path" "$base_path".dpkg-*
}

remove_platform_apt_prefs() {
    # Platform apt pins are activated by postinst (not shipped by dpkg), so
    # remove them and any dpkg leftovers whenever package state changes.
    rm_conffile /etc/apt/preferences.d/isaac-ros-cuda-13-0.pref
    rm_conffile /etc/apt/preferences.d/20-isaac-ros-cuda-13-2.pref
    rm_conffile /etc/apt/preferences.d/20-isaac-ros-dgx-spark.pref
    rm_conffile /etc/apt/preferences.d/20-isaac-ros-jetson.pref
    rm_conffile /etc/apt/preferences.d/isaac-ros-dgx-spark.pref
}

case "$1" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        remove_platform_apt_prefs
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
