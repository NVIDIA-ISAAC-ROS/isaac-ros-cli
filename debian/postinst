set -e

DOCKER_DEB_OVERRIDE_DIR="/etc/isaac-ros-cli/.docker-deb-overrides"

clear_docker_deb_overrides() {
    if [ -d "$DOCKER_DEB_OVERRIDE_DIR" ]; then
        rm -rf "$DOCKER_DEB_OVERRIDE_DIR"
        echo "Cleared Isaac ROS CLI Docker Debian overrides from $DOCKER_DEB_OVERRIDE_DIR"
    fi
}

case "$1" in
    configure)
        clear_docker_deb_overrides

        echo "Creating Isaac ROS virtual environment..."

        # Check if python3 is available
        if ! command -v python3 >/dev/null 2>&1; then
            echo "Error: python3 is not available. Please install python3." >&2
            exit 1
        fi

        # Check if python3-venv is available
        if ! python3 -m venv --help >/dev/null 2>&1; then
            echo "Error: python3-venv is not available. Please install python3-venv." >&2
            exit 1
        fi

        # Create the group that owns the virtual environment
        GROUP_NAME="isaac-ros-cli"
        if ! getent group "${GROUP_NAME}" >/dev/null 2>&1; then
            addgroup --system "${GROUP_NAME}"
            echo "Created system group '${GROUP_NAME}'"
        else
            echo "System group '${GROUP_NAME}' already exists"
        fi

        # Create the virtual environment with read-only access to system site-packages
        VENV_PATH="/var/lib/isaac-ros-cli/isaac-ros"
        if [ ! -d "$VENV_PATH" ]; then
            python3 -m venv --system-site-packages "$VENV_PATH"
            echo "Isaac ROS virtual environment created at $VENV_PATH"
        else
            echo "Isaac ROS virtual environment already exists at $VENV_PATH"
        fi

        # Ensure virtual environment is always owned by the group
        chown -R root:"${GROUP_NAME}" /var/lib/isaac-ros-cli/
        chmod -R g+rwX /var/lib/isaac-ros-cli/
        find /var/lib/isaac-ros-cli/ -type d -exec chmod g+s {} \;

        # Activate platform-specific apt pins only on their target platforms.
        CUDA_13_0_PREF_SRC="/etc/isaac-ros-cli/docker/packaging/isaac-ros-cuda-13-0.pref"
        CUDA_13_0_PREF_DST="/etc/apt/preferences.d/isaac-ros-cuda-13-0.pref"
        CUDA_13_2_PREF_SRC="/etc/isaac-ros-cli/docker/packaging/20-isaac-ros-cuda-13-2.pref"
        CUDA_13_2_PREF_DST="/etc/apt/preferences.d/20-isaac-ros-cuda-13-2.pref"
        SPARK_PREF_SRC="/etc/isaac-ros-cli/docker/packaging/20-isaac-ros-dgx-spark.pref"
        SPARK_PREF_DST="/etc/apt/preferences.d/20-isaac-ros-dgx-spark.pref"
        JETSON_PREF_SRC="/etc/isaac-ros-cli/docker/packaging/20-isaac-ros-jetson.pref"
        JETSON_PREF_DST="/etc/apt/preferences.d/20-isaac-ros-jetson.pref"
        PLATFORM_PY="/usr/lib/python3/dist-packages/isaac_ros_cli/platform.py"
        platform="${ISAAC_ROS_PLATFORM:-}"
        if [ -z "${platform}" ] && [ -f "${PLATFORM_PY}" ]; then
            platform="$(python3 "${PLATFORM_PY}" 2>/dev/null || true)"
        fi

        # The pin lives at a non-conffile path, so deploy it with conffile-like
        # semantics (--force-confold): install when absent, otherwise keep an
        # admin-modified file and leave the packaged version as .dpkg-dist.
        activate_platform_pref() {
            expected_platforms="$1"
            pref_src="$2"
            pref_dst="$3"
            platform_name="$4"

            should_activate=0
            if [ -n "${platform}" ]; then
                case " ${expected_platforms} " in
                    *" ${platform} "*)
                        should_activate=1
                        ;;
                esac
            fi

            if [ "${should_activate}" -eq 1 ]; then
                if [ ! -f "$pref_src" ]; then
                    echo "Skipping ${platform_name} apt pin activation: missing source $pref_src" >&2
                    return 0
                fi
                if [ ! -e "$pref_dst" ]; then
                    install -m 0644 "$pref_src" "$pref_dst"
                    echo "Activated ${platform_name} apt pin: $pref_dst"
                elif ! cmp -s "$pref_src" "$pref_dst"; then
                    install -m 0644 "$pref_src" "$pref_dst.dpkg-dist"
                    echo "Kept modified ${platform_name} apt pin; packaged version at $pref_dst.dpkg-dist"
                else
                    rm -f "$pref_dst.dpkg-dist"
                fi
            else
                rm -f "$pref_dst" "$pref_dst.dpkg-dist"
            fi
        }

        activate_platform_pref \
            "amd64 arm64-jetpack" \
            "$CUDA_13_2_PREF_SRC" "$CUDA_13_2_PREF_DST" "CUDA 13.2"
        activate_platform_pref \
            "arm64-fastos" "$CUDA_13_0_PREF_SRC" "$CUDA_13_0_PREF_DST" "CUDA 13.0"
        activate_platform_pref \
            "arm64-fastos" "$SPARK_PREF_SRC" "$SPARK_PREF_DST" "DGX Spark"
        activate_platform_pref \
            "arm64-jetpack" "$JETSON_PREF_SRC" "$JETSON_PREF_DST" "Jetson"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
