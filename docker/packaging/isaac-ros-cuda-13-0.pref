# Keep any installed CUDA 13.0 package, including cuda-toolkit-13-0, in place.
# A priority below 1000 prevents downgrades while still outranking the validated
# release pins below.
Package: cuda-*-13-0 libcu*-13-0 libnv*-13-0
Pin: release a=now
Pin-Priority: 999

# Keep CUDA toolkit metapackages on validated CUDA 13.0 releases when CUDA is
# not already installed. Keep the priority below 1000 so apt never downgrades an
# installed package to this release.
Package: cuda-toolkit-13-0 cuda-compiler-13-0 cuda-libraries-13-0 cuda-libraries-dev-13-0
Pin: version 13.0.*
Pin-Priority: 990

Package: cuda-tools-13-0 cuda-command-line-tools-13-0 cuda-visual-tools-13-0
Pin: version 13.0.*
Pin-Priority: 990

Package: cuda-nsight-compute-13-0 cuda-nsight-systems-13-0
Pin: version 13.0.*
Pin-Priority: 990

# Keep CUDA toolkit transitive dependencies on CUDA 13.0 package variants.
Package: cuda-*-13-0 libcu*-13-0 libnv*-13-0
Pin: version *
Pin-Priority: 990

# These CUDA toolkit config packages are shared across CUDA minor package names,
# so constrain them by package version rather than by a -13-0 package suffix.
Package: cuda-toolkit-13-0-config-common cuda-toolkit-config-common
Pin: version 13.0.*
Pin-Priority: 990
